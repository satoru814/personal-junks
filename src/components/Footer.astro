---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE}
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em;
		color: var(--muted);
		text-align: center;
		font-size: 0.8em;
		letter-spacing: 0.05em;
		border-top: 1px solid var(--line);
	}
</style>
