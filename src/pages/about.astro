---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="このブログと書き手について" />
		<style>
			h1 {
				margin-bottom: 1.2em;
			}
			dl {
				margin: 1em 0;
			}
			dt {
				font-size: 0.8em;
				letter-spacing: 0.08em;
				color: var(--muted);
			}
			dd {
				margin: 0.1em 0 1.1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<h1>About</h1>

				<p>
					Satoru Sakamoto。AIエンジニア。LLM
					エージェントの設計と評価 — エージェントの振る舞いをどう検証し、どう良くしていくか —
					を仕事の中心にしています。
				</p>

				<p>
					興味があるのは、AI そのものというより、AI
					が入ってきたときに人の考えごとや組織の営みがどう変わっていくのか、というあたり。知識とか、検証とか、
					探索とか、自由意志とか、そのへんを行ったり来たりしながら考えています。
					このブログはその考えごとの置き場で、名前の通りぜんぶ書きかけ（in progress）です。
				</p>

				<h2>経歴</h2>
				<dl>
					<dt>現在</dt>
					<dd>AIエンジニア。LLMエージェント・評価基盤の開発。</dd>
				</dl>

				<h2>連絡先</h2>
				<dl>
					<dt>GitHub</dt>
					<dd><a href="https://github.com/satoru814">@satoru814</a></dd>
					<dt>LinkedIn</dt>
					<dd>
						<a href="https://www.linkedin.com/in/sakamoto-satoru-72a2a1236/"
							>sakamoto-satoru</a
						>
					</dd>
				</dl>
			</article>
		</main>
		<Footer />
	</body>
</html>
